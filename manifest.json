{
  "manifest_version": 3,
  "name": "Clean New Tab",
  "description": "Персональная новая вкладка для Brave и Chromium браузеров.",
  "chrome_url_overrides": {
    "newtab": "src/pages/newtab/index.html"
  },
  "icons": {
    "16": "icon-32.png",
    "32": "icon-32.png",
    "128": "icon-128.png"
  },
  "permissions": ["storage", "favicon"],
  "host_permissions": ["https://api.github.com/*", "https://github.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*", "favicon.svg", "icon-128.png", "icon-32.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
